APP_NAME=Team AI Gateway
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000/v1
DATABASE_URL=sqlite+aiosqlite:///./data/ai_gateway.db
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=480
API_KEY_PEPPER=replace-with-another-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_SYNC_ENABLED=true
MODEL_SYNC_INTERVAL_SECONDS=21600
MODEL_SYNC_INITIAL_DELAY_SECONDS=10
CORS_ORIGINS=http://localhost:5173
AUTO_MIGRATE=true
